# ============================================================
# AutoFeeder Rail Gantry - example environment
# Copy to backend/.env and replace every secret with a random value.
# NEVER commit backend/.env.
# ============================================================

ENVIRONMENT=development
DEBUG=false

# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-64-random-characters-from-secrets-token-urlsafe
# Generate: python3 -c "import secrets; print('fg_' + secrets.token_urlsafe(32))"
DEVICE_API_KEY=replace-with-a-random-device-key-min-24-chars

# SQLite by default (zero setup). For Fish Linker / production use MySQL:
# DATABASE_URL=mysql+pymysql://feeder_user:strong-password@127.0.0.1:3306/budidaya_lele
DATABASE_URL=sqlite:///./data/autofeeder.db

CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOW_REGISTRATION=true
PUBLIC_MONITORING=false

DEVICE_ID=lele-gantry-001
DEVICE_NAME=Gantry Lele 001
DEVICE_OFFLINE_SECONDS=30
COMMAND_TTL_SECONDS=120

SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=5
SCHEDULE_LATE_GRACE_SECONDS=900
HOPPER_CAPACITY_KG=15
GRAMS_PER_ROTATION=200
MAX_PORTION_GRAMS=10000
MAX_MANUAL_PORTION_GRAMS=5000
RETENTION_DAYS=365

# Demo seed. Set false in production (production refuses true).
SEED_DEMO=true
DEMO_PASSWORD_ADMIN=Admin#12345
DEMO_PASSWORD_OWNER=Pemilik#12345
DEMO_PASSWORD_OPERATOR=Petani#12345

# Optional: import ponds/users/feed from an existing Fish Linker MySQL database.
# FISHLINKER_DATABASE_URL=mysql+pymysql://lele:password@127.0.0.1:3306/budidaya_lele
